{
    "name": "@buildingai/agent-core",
    "version": "0.0.0",
    "private": true,
    "license": "Apache-2.0",
    "description": "桌面客户端 Node sidecar：Pi 引擎宿主、策略引擎、执行层、审计采集器（stdio JSON-RPC 对外）",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.js"
        }
    },
    "scripts": {
        "clean": "rimraf dist .turbo dist/build.tsbuildinfo",
        "check-types": "tsc --noEmit",
        "build": "rimraf dist && tsc -p tsconfig.build.json",
        "dev": "tsc -p tsconfig.build.json --watch",
        "lint": "eslint . --quiet",
        "lint:fix": "eslint . --fix",
        "smoke": "node scripts/smoke.mjs",
        "smoke:engine": "node scripts/smoke-engine.mjs"
    },
    "dependencies": {
        "@earendil-works/pi-ai": "0.82.1",
        "@earendil-works/pi-coding-agent": "0.82.1",
        "@ff-labs/pi-fff": "0.10.5",
        "@juicesharp/rpiv-ask-user-question": "2.7.1",
        "@juicesharp/rpiv-todo": "2.7.1",
        "@narumitw/pi-plan-mode": "0.55.3",
        "@tintinweb/pi-subagents": "0.18.2",
        "docx": "^9.7.1",
        "dotenv": "catalog:",
        "mammoth": "^1.12.1",
        "pptxgenjs": "^4.0.1",
        "typebox": "^1.0.9",
        "xlsx": "^0.18.5"
    },
    "devDependencies": {
        "@buildingai/eslint-config": "workspace:*",
        "@buildingai/typescript-config": "workspace:*",
        "@types/node": "catalog:dev"
    },
    "engines": {
        "node": ">=22"
    }
}
